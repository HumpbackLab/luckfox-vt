ifeq ($(APP_PARAM),)
APP_PARAM:=../Makefile.param
include $(APP_PARAM)
endif

export LC_ALL=C
SHELL:=/bin/bash

CURRENT_DIR := $(shell pwd)
PKG_NAME := ipc_lite
PKG_BUILD := build
PKG_BIN := out

RK_APP_CFLAGS := -I$(RK_APP_MEDIA_INCLUDE_PATH) \
	-I$(RK_APP_MEDIA_INCLUDE_PATH)/rkaiq \
	-I$(RK_APP_MEDIA_INCLUDE_PATH)/rkaiq/uAPI2 \
	-I$(RK_APP_MEDIA_INCLUDE_PATH)/rkaiq/common \
	-I$(RK_APP_MEDIA_INCLUDE_PATH)/rkaiq/xcore \
	-I$(RK_APP_MEDIA_INCLUDE_PATH)/rkaiq/algos \
	-I$(RK_APP_MEDIA_INCLUDE_PATH)/rkaiq/iq_parser \
	-I$(RK_APP_MEDIA_INCLUDE_PATH)/rkaiq/iq_parser_v2

RK_APP_INCLUDE_DIRS := $(RK_APP_MEDIA_INCLUDE_PATH);$(RK_APP_MEDIA_INCLUDE_PATH)/rkaiq;$(RK_APP_MEDIA_INCLUDE_PATH)/rkaiq/uAPI2;$(RK_APP_MEDIA_INCLUDE_PATH)/rkaiq/common;$(RK_APP_MEDIA_INCLUDE_PATH)/rkaiq/xcore;$(RK_APP_MEDIA_INCLUDE_PATH)/rkaiq/algos;$(RK_APP_MEDIA_INCLUDE_PATH)/rkaiq/iq_parser;$(RK_APP_MEDIA_INCLUDE_PATH)/rkaiq/iq_parser_v2

RK_APP_LDFLAGS := -L$(RK_APP_MEDIA_LIBS_PATH) -L$(RK_APP_PATH_LIB_INCLUDE)/root/usr/lib
RK_APP_OPTS += -Wl,-rpath-link,$(RK_APP_MEDIA_LIBS_PATH):$(RK_APP_PATH_LIB_INCLUDE)/root/usr/lib

PKG_TOOLCHAIN_SYSROOT := $(shell $(RK_APP_CROSS)-gcc -print-sysroot)

PKG_CONF_OPTS += -DCMAKE_BUILD_TYPE=Release
PKG_CONF_OPTS += -DRKIPC_LITE_CROSS_COMPILE="$(RK_APP_CROSS)"
PKG_CONF_OPTS += -DIPC_LITE_MEDIA_INCLUDE_DIRS="$(RK_APP_INCLUDE_DIRS)"
PKG_CONF_OPTS += -DIPC_LITE_LINK_DIRS="$(RK_APP_MEDIA_LIBS_PATH);$(RK_APP_PATH_LIB_INCLUDE)/root/usr/lib"
PKG_CONF_OPTS += -DCMAKE_C_COMPILER=$(RK_APP_CROSS)-gcc
PKG_CONF_OPTS += -DCMAKE_SYSROOT="$(PKG_TOOLCHAIN_SYSROOT)"
PKG_CONF_OPTS += -DCMAKE_FIND_ROOT_PATH="$(PKG_TOOLCHAIN_SYSROOT);$(RK_APP_PATH_LIB_INCLUDE)"
PKG_CONF_OPTS += -DCMAKE_C_FLAGS="$(RK_APP_CFLAGS) $(RK_APP_LDFLAGS) $(RK_APP_OPTS) $(RK_APP_CROSS_CFLAGS)"
PKG_CONF_OPTS += -DCMAKE_EXE_LINKER_FLAGS="$(RK_APP_LDFLAGS) $(RK_APP_OPTS)"

all: build

build:
	rm -rf $(PKG_BUILD) $(PKG_BIN)
	mkdir -p $(PKG_BUILD) $(PKG_BIN)
	cd $(PKG_BUILD) && cmake $(CURRENT_DIR) \
		-DCMAKE_INSTALL_PREFIX="$(CURRENT_DIR)/$(PKG_BIN)" \
		$(PKG_CONF_OPTS)
	$(MAKE) -C $(PKG_BUILD)
	$(MAKE) -C $(PKG_BUILD) install
	$(call MAROC_COPY_PKG_TO_APP_OUTPUT, $(RK_APP_OUTPUT), $(PKG_BIN))

clean:
	rm -rf $(PKG_BUILD) $(PKG_BIN)

distclean: clean

info:
	@echo "ipc_lite"
